# FlutterFlow CLI authentication for local development.
FF_API_KEY=YOUR_FLUTTERFLOW_API_KEY

# Public AVARYN legal-document URLs.
AVARYN_PRIVACY_POLICY_URL=https://example.com/privacy
AVARYN_TERMS_URL=https://example.com/terms

# Supabase client configuration.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# STRICTLY SERVER-SIDE ONLY.
# Never include this value in the Flutter app, web frontend, or any client bundle.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SUPABASE_SERVICE_ROLE_KEY
